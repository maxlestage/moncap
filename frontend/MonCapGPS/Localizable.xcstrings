            "state": "translated",
            "value": "Anchura"
          }
        }
      }
    },
    "Le paquet « %@ » ne s'ouvre pas. Supprime-le et réinstalle-le depuis l'écran hors ligne.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “%@” package will not open. Delete it and reinstall it from the offline screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete «%@» no se abre. Elimínalo y vuelve a instalarlo desde la pantalla sin conexión."
