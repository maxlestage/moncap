            "value": "Ninguna ruta"
          }
        }
      }
    },
    "Aucun trajet en transports trouvé pour cette destination.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transit journey found for this destination."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún trayecto en transporte para este destino."
          }
        }
      }
    },
    "Aucun trajet enregistré pour l'instant. Lance une navigation : ton trajet sera sauvegardé automatiquement à l'arrivée.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No trip saved yet. Start navigating: your trip is saved automatically on arrival."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay ningún viaje guardado. Inicia una navegación: tu viaje se guardará solo al llegar."
          }
        }
      }
    },
    "Aucune mesure ici. Rapproche-toi des terres.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No measurement here. Move closer to land."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna medición aquí. Acércate a tierra firme."
          }
        }
      }
    },
    "Aucune position — utilise « Enregistrer ma position ».": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No position — use “Save my position”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna posición — usa «Guardar mi posición»."
          }
        }
      }
    },
    "Aucune région d'itinéraires n'est installée. Télécharge celle qui te concerne depuis l'écran hors ligne.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No routing region is installed. Download the one you need from the offline screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna región de rutas instalada. Descarga la que te interesa desde la pantalla sin conexión."
          }
        }
      }
    },
    "Aucune région de ce nom.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No region by that name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna región con ese nombre."
          }
        }
      }
    },
    "Aucune région installée ne couvre ce trajet. Il doit tenir entier dans un même paquet : c'est à cela que servent les zones, qui se chevauchent.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed region covers this trip. It must fit entirely within one package — that is what the overlapping areas are for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna región instalada cubre este trayecto. Debe caber entero en un mismo paquete: para eso sirven las zonas, que se solapan."
          }
        }
      }
    },
    "Aucune région installée ne répond à cet endroit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No installed region answers at this location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna región instalada responde en este lugar."
          }
        }
      }
    },
