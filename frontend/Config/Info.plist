<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Navigation en arrière-plan : suivi GPS + annonces vocales écran
	     verrouillé. Les autres clés sont générées par Xcode
	     (GENERATE_INFOPLIST_FILE = YES fusionne avec ce fichier). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>audio</string>
	</array>
	<!-- CarPlay : la scène est déclarée, l'écran (CarPlayEcran.swift) est
	     prêt. Elle reste dormante tant que l'entitlement
	     com.apple.developer.carplay-maps n'a pas été accordé par Apple
	     (demande sur developer.apple.com → Additional Capabilities) : sans
	     lui, iOS ne crée jamais cette scène. Seule la scène CarPlay est
	     listée : l'écran du téléphone reste piloté par SwiftUI. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>MonCapCarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
	<!-- Lien profond moncap://trajet?… : la page de partage d'itinéraire du
	     serveur (« Ouvrir dans MonCap GPS ») rouvre l'app sur le même trajet. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.moncap.gps.trajet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>moncap</string>
			</array>
		</dict>
	</array>
	<!-- La Live Activity du guidage : consigne, distance et heure d'arrivée
	     sur l'écran verrouillé et dans la Dynamic Island. Dessinée par
	     l'extension Guidage, pilotée par NavigationManager. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Pas un jeu : déclaré explicitement, sinon iOS 27 logge à chaque
	     lancement « LSSupportsGameMode key not found in Info.plist ». -->
	<key>LSSupportsGameMode</key>
	<false/>
	<!-- Écran de lancement natif : fond bleu de marque (évite le flash blanc
	     avant l'apparition de la vue SwiftUI de chargement). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
