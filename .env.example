# La base SQLite (créée au premier démarrage, dossier compris).
DATABASE_URL=sqlite://data/moncap.db
# Le cache SQLite (tuiles, feux, air, régions hors ligne) : jetable.
# CACHE_URL=sqlite://data/cache.db
# Poids maximal du cache, en Mo (512 par défaut).
# CACHE_MAX_MO=512
# Sauvegarde de la base dans une Release GitHub privée (voir README) :
# un jeton « Contents: Read and write » sur ce seul dépôt.
# SAUVEGARDE_TOKEN=
# SAUVEGARDE_DEPOT=maxlestage/moncap
